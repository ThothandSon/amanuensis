{
  "name": "amanuensis",
  "private": true,
  "version": "0.1.0",
  "description": "Next-generation CAT Workbench with Auxiliary TMs, Scanned PDF to Searchable PDF/Markdown Suite, and Evolving Local LLM Project Harness",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:rust": "cargo test --workspace",
    "init:harness": "cargo run -p amanuensis-desktop -- --init-harness sample-project"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
